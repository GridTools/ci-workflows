#!/usr/bin/env bash
# Decides whether a PR comment may reach PR Agent as a command.
#
# Usage: BODY=<comment body> check-command
# Exit 0 and print nothing if allowed; exit 1 and print the reason if not.
#
# Only these commands: others write labels (/generate_labels) or need
# 'contents: write' (/update_changelog), and PR Agent cannot restrict them.
# No '--section.key=value' arguments: they override every setting that is not
# host-only, including the ones that keep model output out of labels and the
# PR description.
#
# PR Agent v0.50.0 splits a comment with shlex (posix, whitespace_split,
# quotes '"', no commenters) after Python's strip(), and treats an argument as
# a setting if arg.strip() starts with '--'. Quotes and backslashes vanish in
# that lexer, so '\--x', '-\-x' and '"-"-x' all become '--x'. This check
# over-approximates instead of re-implementing the lexer: with '"' and '\'
# deleted, any '--' not directly after an ASCII letter, digit or '_' is
# refused. tests/test-command-filter.py checks it against the real lexer.

set -euo pipefail
export LC_ALL=C

body=${BODY-}
command=${body%%[[:space:]]*}
case "${command}" in
  /review | /improve | /ask | /describe | /help) ;;
  *)
    echo "Ignoring '${command:0:40}': only /review, /improve, /ask, /describe and /help are enabled."
    exit 1
    ;;
esac
stripped=${body//[\"\\]/}
if [[ "${stripped}" =~ (^|[^A-Za-z0-9_])-- ]]; then
  echo "Ignoring the command: '--' setting arguments are not accepted."
  exit 1
fi
